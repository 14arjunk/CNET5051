def hello(data=None):
    """
    This is a function that takes anything as `data` and returns
    a string depending on the input.

    Parameters:
    data (type): Description of the first parameter.

    Returns:
    out (str): String with the answer.
    """

    out = ''
    if data:
        out += "Hello, World!"

    else:
        out += 'Set "data" to something!'


    return out


